# Epidemic final size: an SIR outbreak written as two reactions, S + I -> 2 I and I -> R.
# For every basic reproduction number R0 the simulated attack rate must match the classic
# final-size relation S_inf = S0 exp(-R0 (1 - S_inf)), and it always overshoots the
# herd-immunity threshold 1 - 1/R0.
mkdir("build/examples");
p = _lmcode_ cli="lmbio" install="github:lmctl-ai/lmbio@latest";
let m = bio.model("sir").compartment("population", 1.0).species("S", "population", 0.9999).species("I", "population", 0.0001).species("R", "population", 0.0);
m.param("beta", 0.2).param("gamma", 0.1);
m.reaction("infection", "S + I -> 2 I", "beta*S*I").reaction("recovery", "I -> R", "gamma*I");
m.tol(0.000000001, 0.000000000001);
for (i in range(0, 8)) {
  let r0 = 1.25 + 0.5 * float(i);
  m.set("beta", r0 * 0.1);
  let run = m.simulate(0.0, 900.0, 901);
  # final-size relation by fixed-point iteration from S = 0 (the epidemic root)
  let s = 0.0;
  for (k in range(0, 400)) {
    s = 0.9999 * pow(2.718281828459045, -r0 * (1.0 - s));
  }
  bio.assert_close(run.final("S"), s, 0.0002);
  bio.assert_true(1.0 - run.final("S") > 1.0 - 1.0 / r0);
  bio.print("row," + str(r0) + "," + str(run.final("R") + run.final("I")) + "," + str(run.max("I")) + "," + str(run.time_of_max("I")));
  if (i == 1 || i == 3 || i == 5 || i == 7) {
    run.save_csv("build/examples/sir_epidemic_" + str(i) + ".csv");
  }
}
end _lmcode_
savedsl(p, "build/sir_epidemic.dslb");
r = system ${dsl_cli(p)} --dsl build/sir_epidemic.dslb;
assert(r.code == 0);
csv = "R0,attack,peak,peak_day\n";
for (line in split(r.stdout, "\n")) {
  if (starts_with(line, "row,")) { csv = csv + substr(line, 4) + "\n"; }
}
write_file("build/examples/sir_epidemic_sizes.csv", csv);

mkdir("images");
v = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/sir_epidemic.png", 960, 540);
plot.cmd("set datafile separator ','");
plot.cmd("set multiplot layout 1,2 title 'Epidemic final size: higher R0, faster and larger outbreaks' font ',14'");
plot.cmd("set border 3; set tics nomirror; set grid back lc rgb '#e4e9ef'");
plot.cmd("set title 'Infected fraction over time'");
plot.cmd("set xlabel 'Day'; set ylabel 'Infected fraction I'");
plot.cmd("set key top right Left reverse samplen 2");
plot.cmd("set xrange [0:250]; set yrange [0:0.5]");
plot.cmd("plot for [i=1:7:2] sprintf('build/examples/sir_epidemic_%d.csv', i) using 1:3 with lines lw 3 lc rgb word('#9ccfd2 #5fb3b8 #007f86 #00545a', (i+1)/2) title sprintf('R0 = %g', 1.25+0.5*i)");
plot.cmd("set title 'Who is ever infected (attack rate)'");
plot.cmd("set xlabel 'Basic reproduction number R0'; set ylabel 'Fraction of population'");
plot.cmd("set xrange [1:5]; set yrange [0:1.02]");
plot.cmd("set key at graph 0.22, graph 0.34 left Left reverse samplen 2");
plot.cmd("set parametric; set trange [0.001:0.999]");
plot.cmd("plot -log(1-t)/t, t with lines lw 3 lc rgb '#df6b38' title 'Final-size law z = 1 - exp(-R0 z)', t*4+1, 1-1/(t*4+1) with lines lw 2 dt 2 lc rgb '#5864a8' title 'Herd-immunity threshold 1 - 1/R0', 'build/examples/sir_epidemic_sizes.csv' using 1:2 with points pt 7 ps 2 lc rgb '#007f86' title 'Simulated outbreaks'");
plot.cmd("unset parametric");
plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(v, "build/sir_epidemic-plot.dslb");
r = system ${dsl_cli(v)} --dsl build/sir_epidemic-plot.dslb;
assert(r.code == 0);
println("wrote images/sir_epidemic.png");
