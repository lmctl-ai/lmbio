mkdir("build/visual");
mkdir("docs/images");
v = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("docs/images/reversible_balance.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside top center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Reversible reaction: equilibrium partitions a conserved pool'");
plot.cmd("set xlabel 'Time (model units)'");
plot.cmd("set ylabel 'Concentration'");
plot.cmd("plot 'build/examples/reversible_balance.csv' using 1:2 with lines ls 1 title 'A', '' using 1:3 with lines ls 2 title 'B', 2.0/3 with lines ls 3 dt 2 title 'B equilibrium'");
plot.close();
end _dsl_
savedsl(v,"build/visual/reversible_balance.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/reversible_balance.dslb;
assert(r.code==0);
