mkdir("build/visual");
mkdir("docs/images");
v = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("docs/images/biochemical_network.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside top center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Enzyme catalysis: substrate becomes product'");
plot.cmd("set xlabel 'Time (model units)'");
plot.cmd("set ylabel 'Concentration'");
plot.cmd("plot 'build/examples/biochemical_network.csv' using 1:2 with lines ls 1 title 'Substrate', '' using 1:4 with lines ls 3 title 'Complex', '' using 1:5 with lines ls 2 title 'Product'");
plot.close();
end _dsl_
savedsl(v,"build/visual/biochemical_network.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/biochemical_network.dslb;
assert(r.code==0);
