# Which rate constant matters? Local sensitivity of an enzyme reaction's product to each constant.
# Scaled sensitivity (k/P)(dP/dk) says: a 1% error in k moves P by this many percent. Early on the
# Michaelis-Menten rate gives exact answers that add up to 1: kcat 0.75, kon 0.5, koff -0.25 (here
# Km = 1 and S0 = 1). Once the substrate runs out every constant stops mattering, because all the
# substrate ends up as product anyway. Derivatives are central finite differences of CVODE runs.
mkdir("build/examples");
p = _lmcode_ cli="lmbio" install="github:lmctl-ai/lmbio@latest";
let m = bio.model("enzyme").compartment("cell", 1.0).species("E", "cell", 0.01).species("S", "cell", 1.0).species("ES", "cell", 0.0).species("P", "cell", 0.0);
m.param("kon", 10.0).param("koff", 5.0).param("kcat", 5.0);
m.reaction("bind", "E + S -> ES", "kon*E*S").reversible("bind", "koff*ES").reaction("turnover", "ES -> E + P", "kcat*ES");
m.tol(0.000000000001, 0.00000000000001);
let base = m.simulate(0.0, 300.0, 3001);
let dcat = m.sensitivity("kcat", 0.0, 300.0, 3001, 0.0001);
let don = m.sensitivity("kon", 0.0, 300.0, 3001, 0.0001);
let doff = m.sensitivity("koff", 0.0, 300.0, 3001, 0.0001);
for (i in range(1, 3001)) {
  let product = base.value("P", i);
  let a = 5.0 * dcat.value("P", i) / product;
  let b = 10.0 * don.value("P", i) / product;
  let c = 5.0 * doff.value("P", i) / product;
  if (i == 20) {
    bio.assert_close(a, 0.75, 0.03);
    bio.assert_close(b, 0.5, 0.06);
    bio.assert_close(c, -0.25, 0.03);
  }
  if (i == 3000) { bio.assert_true(abs(a) < 0.001 && abs(b) < 0.001 && abs(c) < 0.001); }
  bio.print("row," + str(base.value("time", i)) + "," + str(product) + "," + str(a) + "," + str(b) + "," + str(c));
}
end _lmcode_
savedsl(p, "build/parameter_sensitivity.dslb");
r = system ${dsl_cli(p)} --lmcode build/parameter_sensitivity.dslb;
assert(r.code == 0);
csv = "time,P,kcat,kon,koff\n";
for (line in split(r.stdout, "\n")) {
  if (starts_with(line, "row,")) { csv = csv + substr(line, 4) + "\n"; }
}
write_file("build/examples/parameter_sensitivity.csv", csv);

mkdir("images");
v = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/parameter_sensitivity.png", 960, 560);
plot.cmd("set datafile separator ','");
plot.cmd("set multiplot layout 2,1 title 'Parameter sensitivity: which rate constant controls the product, and when' font ',14' margins 0.1,0.78,0.14,0.88 spacing 0,0.07");
plot.cmd("set border 3; set tics nomirror; set grid back lc rgb '#e4e9ef'");
plot.cmd("set logscale x; set xrange [0.1:300]");
plot.cmd("set format x ''");
plot.cmd("set ylabel 'Product P'; set yrange [0:1.05]; set ytics 0.25");
plot.cmd("set key at screen 0.99, screen 0.80 right Right noreverse samplen 2");
plot.cmd("plot 'build/examples/parameter_sensitivity.csv' using 1:2 with lines lw 3 lc rgb '#1d2733' title 'Product (S0 = 1)'");
plot.cmd("set format x '%g'");
plot.cmd("set xlabel 'Time (log scale)'; set ylabel '(k/P) dP/dk'; set yrange [-0.4:1.0]; set ytics 0.25");
plot.cmd("set key at screen 0.99, screen 0.48 right Right noreverse samplen 2");
plot.cmd("set arrow 1 from 0.1,0 to 300,0 nohead lc rgb '#8a8f96'");
plot.cmd("set label 1 \"Once the substrate\nis used up, no\nconstant matters.\" at screen 0.80, screen 0.30 left tc rgb '#5a6672'");
plot.cmd("plot 'build/examples/parameter_sensitivity.csv' using 1:3 with lines lw 3 lc rgb '#007f86' title 'kcat (turnover)', '' using 1:4 with lines lw 3 lc rgb '#df6b38' title 'kon (binding)', '' using 1:5 with lines lw 3 lc rgb '#5864a8' title 'koff (unbinding)', 0.75 with lines dt 2 lw 1.5 lc rgb '#007f86' title 'early-time theory', 0.5 with lines dt 2 lw 1.5 lc rgb '#df6b38' notitle, -0.25 with lines dt 2 lw 1.5 lc rgb '#5864a8' notitle");
plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(v, "build/parameter_sensitivity-plot.dslb");
r = system ${dsl_cli(v)} --lmcode build/parameter_sensitivity-plot.dslb;
assert(r.code == 0);
println("wrote images/parameter_sensitivity.png");
