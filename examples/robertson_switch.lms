mkdir("build/examples");
p = _dsl_ cli="lmbio" install="github:lmctl-ai/lmbio@latest";
let m=bio.model("robertson").compartment("v",1.0).species("A","v",1.0).species("B","v",0.0).species("C","v",0.0).reaction("f","A -> B","0.04*A").reaction("r","B + C -> A + C","10000*B*C").reaction("sink","2 B -> B + C","30000000*B*B");
let r=m.simulate(0.0,40.0,401);bio.assert_close(r.final("A"),0.715827,0.0001);r.save_csv("build/examples/robertson_switch.csv");
end _dsl_
savedsl(p, "build/robertson_switch.dslb");
r = system ${dsl_cli(p)} --dsl build/robertson_switch.dslb;
assert(r.code == 0);

mkdir("build/visual");
mkdir("images");
v = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/robertson_switch.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside top center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Robertson kinetics: a fast intermediate feeds slow conversion'");
plot.cmd("set xlabel 'Time (model units)'");
plot.cmd("set ylabel 'Concentration'");
plot.cmd("plot 'build/examples/robertson_switch.csv' using 1:2 with lines ls 1 title 'A', '' using 1:4 with lines ls 2 title 'C'");
plot.close();
end _dsl_
savedsl(v,"build/visual/robertson_switch.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/robertson_switch.dslb;
assert(r.code==0);

println("wrote images/robertson_switch.png");
