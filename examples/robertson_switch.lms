# Robertson's stiff chemistry (1966), the classic test for implicit integrators: rate constants
# span nine orders of magnitude, so the intermediate B jumps to about 3.6e-5 within a fraction of a
# second and then tracks the slow conversion of A into C for a hundred thousand time units.
# CVODE's BDF method covers 1e-6 .. 1e5 in decade segments; the reference value A(40) = 0.715827.
mkdir("build/examples");
p = _dsl_ cli="lmbio" install="github:lmctl-ai/lmbio@latest";
let m=bio.model("robertson").compartment("v",1.0).species("A","v",1.0).species("B","v",0.0).species("C","v",0.0).reaction("f","A -> B","0.04*A").reaction("r","B + C -> A + C","10000*B*C").reaction("sink","2 B -> B + C","30000000*B*B");
m.tol(0.000000001, 0.000000000001);
let r=m.simulate(0.0,40.0,401);bio.assert_close(r.final("A"),0.715827,0.0001);r.save_csv("build/examples/robertson_switch.csv");
# decade segments on a log time axis, each restarted from the previous segment's end state
let t0 = 0.0;
let peak = 0.0;
for (k in range(0, 12)) {
  let t1 = pow(10.0, float(k) - 6.0);
  let s = m.simulate(t0, t1, 61);
  s.save_csv("build/examples/robertson_switch_" + str(k) + ".csv");
  peak = max(peak, s.max("B"));
  bio.assert_close(s.final("A") + s.final("B") + s.final("C"), 1.0, 0.000001);
  m.set("A", s.final("A")).set("B", s.final("B")).set("C", s.final("C"));
  t0 = t1;
}
bio.assert_close(peak, 0.0000365, 0.0000005);
bio.assert_true(m.get("C") > 0.97);
end _dsl_
savedsl(p, "build/robertson_switch.dslb");
r = system ${dsl_cli(p)} --dsl build/robertson_switch.dslb;
assert(r.code == 0);

mkdir("images");
v = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/robertson_switch.png", 960, 540);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3; set tics nomirror; set grid back lc rgb '#e4e9ef'");
plot.cmd("set title 'Robertson stiff kinetics: one intermediate, nine orders of magnitude in rate' font ',14'");
plot.cmd("set xlabel 'Time (log scale)'; set ylabel 'Concentration'");
plot.cmd("set logscale x; set format x '10^{%L}'; set xrange [1e-6:1e5]; set yrange [0:1.05]");
plot.cmd("set key at graph 0.02, graph 0.9 left top Left reverse samplen 2");
plot.cmd("set label 1 'B rises within 1e-3 time units,' at 2e-6,0.56 tc rgb '#5864a8'");
plot.cmd("set label 2 'then decays as A runs out' at 2e-6,0.51 tc rgb '#5864a8'");
plot.cmd("plot for [k=0:11] sprintf('build/examples/robertson_switch_%d.csv', k) using 1:2 with lines lw 3 lc rgb '#007f86' title (k==0 ? 'A (reactant)' : ''), for [k=0:11] sprintf('build/examples/robertson_switch_%d.csv', k) using 1:($3*1e4) with lines lw 3 lc rgb '#5864a8' title (k==0 ? 'B x 10^4 (fast intermediate)' : ''), for [k=0:11] sprintf('build/examples/robertson_switch_%d.csv', k) using 1:4 with lines lw 3 lc rgb '#df6b38' title (k==0 ? 'C (product)' : '')");
plot.close();
end _dsl_
savedsl(v, "build/robertson_switch-plot.dslb");
r = system ${dsl_cli(v)} --dsl build/robertson_switch-plot.dslb;
assert(r.code == 0);
println("wrote images/robertson_switch.png");
