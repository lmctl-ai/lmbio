# When does a feedback loop start to oscillate? The Goodwin oscillator: mRNA x makes enzyme y,
# y makes repressor z, and z shuts off x with a Hill function of steepness n. Linear stability
# gives the secant condition: with three equal decay rates the loop oscillates only when its
# logarithmic gain n z^n/(1 + z^n) at the steady state exceeds 8. This what-if sweep finds that
# threshold from the formula and checks it against simulated amplitudes.
mkdir("build/examples");
p = _lmcode_ cli="lmbio" install="github:lmctl-ai/lmbio@latest";
let m = bio.model("goodwin").compartment("cell", 1.0).species("x", "cell", 0.1).species("y", "cell", 0.2).species("z", "cell", 0.3).param("a", 10.0).param("n", 10.0);
m.reaction("transcribe", " -> x", "a/(1 + z^n)").reaction("x_decay", "x ->", "x");
m.reaction("translate", " -> y", "x").reaction("y_decay", "y ->", "y");
m.reaction("synthesize", " -> z", "y").reaction("z_decay", "z ->", "z");
m.tol(0.000000001, 0.000000000001);
let threshold = -1.0;
let last_gain = 0.0;
for (j in range(0, 41)) {
  let n = 6.0 + 0.25 * float(j);
  # steady state: x = y = z and z (1 + z^n) = a, by bisection
  let lo = 0.0;
  let hi = 10.0;
  for (k in range(0, 80)) {
    let mid = 0.5 * (lo + hi);
    if (mid * (1.0 + pow(mid, n)) > 10.0) { hi = mid; } else { lo = mid; }
  }
  let zs = 0.5 * (lo + hi);
  let gain = n * pow(zs, n) / (1.0 + pow(zs, n));
  if (threshold < 0.0 && gain >= 8.0) { threshold = n - 0.25 * (gain - 8.0) / (gain - last_gain); }
  last_gain = gain;
  m.set("n", n);
  let r = m.simulate(0.0, 600.0, 12001);
  let top = 0.0;
  let bottom = 100.0;
  for (i in range(10000, 12001)) {
    top = max(top, r.value("x", i));
    bottom = min(bottom, r.value("x", i));
  }
  bio.print("row," + str(n) + "," + str(top - bottom) + "," + str(gain));
  if (j == 4 || j == 20 || j == 40) { r.save_csv("build/examples/goodwin_threshold_" + str(j) + ".csv"); }
}
bio.assert_true(threshold > 8.0);
bio.print("threshold," + str(threshold));
end _lmcode_
savedsl(p, "build/goodwin_threshold.dslb");
r = system ${dsl_cli(p)} --lmcode build/goodwin_threshold.dslb;
assert(r.code == 0);
csv = "n,amplitude,gain\n";
threshold = 0.0;
for (line in split(r.stdout, "\n")) {
  if (starts_with(line, "row,")) { csv = csv + substr(line, 4) + "\n"; }
  if (starts_with(line, "threshold,")) { threshold = num(split(line, ",")[1]); }
}
write_file("build/examples/goodwin_threshold_sweep.csv", csv);
# below the predicted threshold every run must have damped out, well above it every run oscillates
for (row in csv_parse(csv)) {
  if (num(row["n"]) < threshold - 0.5) { assert(num(row["amplitude"]) < 0.001); }
  if (num(row["n"]) > threshold + 0.5) { assert(num(row["amplitude"]) > 0.05); }
}
nc = str(round(threshold * 100) / 100);

mkdir("images");
v = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/goodwin_threshold.png", 960, 540);
plot.cmd("set datafile separator ','");
plot.cmd(${"set multiplot layout 1,2 title 'Goodwin oscillator: the loop starts ticking at Hill steepness n = " + nc + "' font ',14'"});
plot.cmd("set border 3; set tics nomirror; set grid back lc rgb '#e4e9ef'");
plot.cmd("set title 'mRNA x for three steepness values'");
plot.cmd("set xlabel 'Time (lifetimes)'; set ylabel 'mRNA x'");
plot.cmd("set xrange [570:600]; set yrange [0:4.8]");
plot.cmd("set key top center horizontal Left reverse samplen 2 width -2");
plot.cmd("plot 'build/examples/goodwin_threshold_4.csv' using 1:2 with lines lw 3 lc rgb '#9ccfd2' title 'n = 7 (settles)', 'build/examples/goodwin_threshold_20.csv' using 1:2 with lines lw 3 lc rgb '#2e9aa0' title 'n = 11', 'build/examples/goodwin_threshold_40.csv' using 1:2 with lines lw 3 lc rgb '#00545a' title 'n = 16'");
plot.cmd("set title 'Oscillation amplitude vs steepness'");
plot.cmd("set xlabel 'Hill steepness n'; set ylabel 'Late-time amplitude of x'");
plot.cmd("set xrange [6:16]; set yrange [0:*]");
plot.cmd(${"set arrow 1 from " + str(threshold) + ", graph 0 to " + str(threshold) + ", graph 1 nohead lc rgb '#df6b38' lw 2 dt 2"});
plot.cmd(${"set label 1 \"secant condition:\\nloop gain = 8\\nat n = " + nc + "\" at " + str(threshold + 1.3) + ", graph 0.22 left tc rgb '#df6b38'"});
plot.cmd("set key top left Left reverse samplen 2");
plot.cmd("plot 'build/examples/goodwin_threshold_sweep.csv' using 1:2 with linespoints lw 3 pt 7 ps 1.2 lc rgb '#007f86' title 'simulated (t = 500-600)'");
plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(v, "build/goodwin_threshold-plot.dslb");
r = system ${dsl_cli(v)} --lmcode build/goodwin_threshold-plot.dslb;
assert(r.code == 0);
println("wrote images/goodwin_threshold.png");
