mkdir("build/examples");
p = _lmcode_ cli="lmbio" install="github:lmctl-ai/lmbio@latest";
let m=bio.model("logistic").compartment("v",1.0).species("N","v",1.0).reaction("growth","N -> 2 N","0.8*N").reaction("crowd","N ->","0.008*N*N");
let r=m.simulate(0.0,15.0,301);bio.assert_close(r.final("N"),99.93921,0.001);r.save_csv("build/examples/logistic_limit.csv");
end _lmcode_
savedsl(p, "build/logistic_limit.dslb");
r = system ${dsl_cli(p)} --dsl build/logistic_limit.dslb;
assert(r.code == 0);

mkdir("build/visual");
mkdir("images");
v = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/logistic_limit.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key bottom right Right noreverse samplen 2");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Logistic growth: crowding creates a carrying capacity'");
plot.cmd("set xlabel 'Time (model units)'");
plot.cmd("set ylabel 'Population (model units)'");
plot.cmd("set xrange [0:15]");
plot.cmd("plot 'build/examples/logistic_limit.csv' using 1:2 with lines ls 1 title 'Population', 100 with lines ls 2 dt 2 title 'Carrying capacity'");
plot.close();
end _lmcode_
savedsl(v,"build/visual/logistic_limit.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/logistic_limit.dslb;
assert(r.code==0);

println("wrote images/logistic_limit.png");
