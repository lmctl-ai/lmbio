mkdir("build/examples");
p = _lmcode_ cli="lmbio" install="github:lmctl-ai/lmbio@latest";
let m=bio.model("cascade").compartment("v",1.0).species("A","v",1.0).species("B","v",0.0).species("C","v",0.0).reaction("first","A -> B","A").reaction("next","B -> C","B");
let r=m.simulate(0.0,8.0,161);bio.assert_close(r.final("C"),0.99698084,0.00001);r.save_csv("build/examples/cascade_delay.csv");
end _lmcode_
savedsl(p, "build/cascade_delay.dslb");
r = system ${dsl_cli(p)} --dsl build/cascade_delay.dslb;
assert(r.code == 0);

mkdir("build/visual");
mkdir("images");
v = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/cascade_delay.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key center right Right noreverse samplen 2");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Sequential conversion: the intermediate peaks before product rises'");
plot.cmd("set xlabel 'Time (model units)'");
plot.cmd("set ylabel 'Concentration'");
plot.cmd("plot 'build/examples/cascade_delay.csv' using 1:2 with lines ls 1 title 'A', '' using 1:3 with lines ls 3 title 'B', '' using 1:4 with lines ls 2 title 'C'");
plot.close();
end _lmcode_
savedsl(v,"build/visual/cascade_delay.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/cascade_delay.dslb;
assert(r.code==0);

println("wrote images/cascade_delay.png");
