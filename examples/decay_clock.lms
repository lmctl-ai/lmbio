mkdir("build/examples");
p = _lmcode_ cli="lmbio" install="github:lmctl-ai/lmbio@latest";
let m=bio.model("decay").compartment("v",1.0).species("A","v",1.0).param("k",0.7).reaction("loss","A ->","k*A");
let r=m.simulate(0.0,6.0,121);bio.assert_close(r.final("A"),0.01499557682,0.00001);r.save_csv("build/examples/decay_clock.csv");
end _lmcode_
savedsl(p, "build/decay_clock.dslb");
r = system ${dsl_cli(p)} --lmcode build/decay_clock.dslb;
assert(r.code == 0);

mkdir("build/visual");
mkdir("images");
v = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/decay_clock.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key top right Right noreverse samplen 2");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'A molecular clock: first-order decay'");
plot.cmd("set xlabel 'Time (model units)'");
plot.cmd("set ylabel 'Fraction remaining'");
plot.cmd("set xrange [0:6]");
plot.cmd("set yrange [0:1.05]");
plot.cmd("plot 'build/examples/decay_clock.csv' using 1:2 with lines ls 1 title 'CVODE', exp(-0.7*x) with lines ls 2 dt 2 title 'Exact exp(-0.7 t)'");
plot.close();
for(k in range(0,24)) {
plot.png("build/visual/decay_clock-frame-"+str(k)+".png",900,520);
plot.cmd("set arrow 1 from graph "+str(float(k)/23.0)+",0 to graph "+str(float(k)/23.0)+",1 nohead lc rgb '#df6b38' dt 2");
plot.cmd("replot");
plot.close();
}
end _lmcode_
savedsl(v,"build/visual/decay_clock.dslb");
r = system ${dsl_cli(v)} --lmcode build/visual/decay_clock.dslb;
assert(r.code==0);

println("wrote images/decay_clock.png");
if (which("ffmpeg") != null) {
  r = system ffmpeg -y -loglevel error -framerate 8 -i build/visual/decay_clock-frame-%d.png -vf "scale=600:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=64[p];[b][p]paletteuse=dither=none" -loop 0 images/decay_clock.gif;
  assert(r.code == 0);
  println("wrote images/decay_clock.gif");
} else {
  println("SKIP images/decay_clock.gif: ffmpeg is not on PATH (frames are in build/visual/)");
}
