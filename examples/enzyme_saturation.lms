# Enzyme saturation: simulate the full mass-action mechanism E + S <-> ES -> E + P
# at nine substrate levels and recover the Michaelis-Menten law v = Vmax S / (Km + S)
# with Km = (koff + kcat)/kon = 1 and Vmax = kcat E0 = 0.05, without assuming it.
mkdir("build/examples");
p = _dsl_ cli="lmbio" install="github:lmctl-ai/lmbio@latest";
let m = bio.model("enzyme").compartment("cell", 1.0).species("E", "cell", 0.01).species("S", "cell", 1.0).species("ES", "cell", 0.0).species("P", "cell", 0.0);
m.param("kon", 10.0).param("koff", 5.0).param("kcat", 5.0);
m.reaction("bind", "E + S -> ES", "kon*E*S").reversible("bind", "koff*ES").reaction("turnover", "ES -> E + P", "kcat*ES");
m.tol(0.0000000001, 0.000000000001);
for (i in range(0, 9)) {
  let s0 = 0.125 * pow(2.0, float(i));
  m.set("S", s0);
  let early = m.simulate(0.0, 2.0, 401);
  let v = 5.0 * early.max("ES");
  let mm = 0.05 * s0 / (1.0 + s0);
  bio.assert_close(v, mm, 0.03 * mm);
  bio.print("row," + str(s0) + "," + str(v));
  if (i >= 2 && i <= 6) {
    let course = m.simulate(0.0, 60.0, 301);
    course.save_csv("build/examples/enzyme_saturation_" + str(i) + ".csv");
  }
}
end _dsl_
savedsl(p, "build/enzyme_saturation.dslb");
r = system ${dsl_cli(p)} --dsl build/enzyme_saturation.dslb;
assert(r.code == 0);
csv = "S0,v0\n";
for (line in split(r.stdout, "\n")) {
  if (starts_with(line, "row,")) { csv = csv + substr(line, 4) + "\n"; }
}
write_file("build/examples/enzyme_saturation_rates.csv", csv);

mkdir("images");
v = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/enzyme_saturation.png", 960, 540);
plot.cmd("set datafile separator ','");
plot.cmd("set multiplot layout 1,2 title 'Enzyme saturation: the full mechanism reproduces Michaelis-Menten' font ',14'");
plot.cmd("set border 3; set tics nomirror; set grid back lc rgb '#e4e9ef'");
plot.cmd("set title 'Product over time, five substrate levels'");
plot.cmd("set xlabel 'Time'; set ylabel 'Product P'");
plot.cmd("set key top left Left reverse samplen 2");
plot.cmd("set xrange [0:60]; set yrange [0:*]");
plot.cmd("plot for [i=2:6] sprintf('build/examples/enzyme_saturation_%d.csv', i) using 1:5 with lines lw 3 lc rgb word('#9ccfd2 #5fb3b8 #2e9aa0 #007f86 #00545a', i-1) title sprintf('S0 = %g', 0.125*2**i)");
plot.cmd("set title 'Initial rate vs substrate (log axis)'");
plot.cmd("set xlabel 'Substrate S0'; set ylabel 'Initial rate v0'");
plot.cmd("set logscale x 2; set xrange [0.1:40]; set yrange [0:0.056]");
plot.cmd("set xtics ('1/8' 0.125, '1/4' 0.25, '1/2' 0.5, '1' 1, '2' 2, '4' 4, '8' 8, '16' 16, '32' 32)");
plot.cmd("set key at graph 0.99, graph 0.24 right Left reverse samplen 2");
plot.cmd("set arrow 1 from 1,0 to 1,0.025 nohead lc rgb '#5864a8' dt 2 lw 2");
plot.cmd("set arrow 2 from 0.1,0.05 to 40,0.05 nohead lc rgb '#888888' dt 3 lw 2");
plot.cmd("set arrow 3 from 0.1,0.025 to 1,0.025 nohead lc rgb '#5864a8' dt 2 lw 2");
plot.cmd("set label 1 'Km = 1' at 0.92,0.003 right tc rgb '#5864a8'");
plot.cmd("set label 2 'Vmax = 0.05' at 0.13,0.0525 tc rgb '#555555'");
plot.cmd("plot 0.05*x/(1+x) with lines lw 3 lc rgb '#df6b38' title 'Michaelis-Menten law', 'build/examples/enzyme_saturation_rates.csv' using 1:2 with points pt 7 ps 2 lc rgb '#007f86' title 'Full mechanism (CVODE)'");
plot.cmd("unset multiplot");
plot.close();
end _dsl_
savedsl(v, "build/enzyme_saturation-plot.dslb");
r = system ${dsl_cli(v)} --dsl build/enzyme_saturation-plot.dslb;
assert(r.code == 0);
println("wrote images/enzyme_saturation.png");
