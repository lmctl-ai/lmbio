p = _lmcode_ cli="lmbio" install="github:lmctl-ai/lmbio@latest";
let k = 0.1;
for (i in range(1, 4)) {
  let m = bio.model("scan").compartment("cell", 1.0).species("A", "cell", 1.0).param("k", k).reaction("r", "A ->", "k*A");
  let r = m.simulate(0.0, 1.0, 11);
  bio.assert_close(r.final("A"), pow(2.718281828459045, -k), 0.01);
  k = k + 0.1;
}
end _lmcode_
savedsl(p, "build/parameter_scan.dslb");
